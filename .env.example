# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Card company. Leave CARD_PROVIDER unset (or "mock") for test mode.
# Server-only secrets: set them in Render's Environment tab, never commit them.
# CARD_PROVIDER=maplerad
# MAPLERAD_SECRET_KEY=
# MAPLERAD_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=

# Wallet top-ups (Paystack). Test key starts with sk_test_, live with sk_live_.
# Paystack webhook URL: https://<your app>/api/webhooks/paystack
# PAYSTACK_SECRET_KEY=

# Daily move of Paystack's Naira balance to Maplerad's NGN account (lib/sweep.ts). OFF unless AUTO_SWEEP=on.
# AUTO_SWEEP=on
# SWEEP_ACCOUNT_NUMBER=
# SWEEP_BANK_CODE=
# SWEEP_KEEP_KOBO=0
# CRON_SECRET=

# Admin page (/admin): login emails allowed to open it, comma separated
ADMIN_EMAILS=
